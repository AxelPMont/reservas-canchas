rules_version = '2';

// Roles: cada usuario tiene un documento users/{uid} con role = "admin" | "empleado".
// - admin:    crear, editar y eliminar reservas
// - empleado: crear y editar reservas (no eliminar)
// Los documentos de users solo se crean/editan desde la consola de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && role() in ['admin', 'empleado'];
    }

    function isAdmin() {
      return isStaff() && role() == 'admin';
    }

    function validReservation(data) {
      return data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.courtId in ['1', '2']
        && data.startTime is string && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.durationMinutes is int
        && data.durationMinutes >= 30 && data.durationMinutes <= 480
        && data.clientName is string
        && data.clientName.size() > 0 && data.clientName.size() <= 200
        && (data.get('phone', null) == null
            || (data.phone is string && data.phone.size() <= 20))
        && (data.get('deposit', null) == null
            || (data.deposit.amount is number && data.deposit.amount > 0));
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /reservations/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && validReservation(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      // Las reservas que ya terminaron (endsAt en el pasado) no se pueden editar.
      // Las reservas antiguas sin endsAt solo se bloquean desde la app.
      allow update: if isStaff()
        && (resource.data.get('endsAt', null) == null || resource.data.endsAt > request.time)
        && validReservation(request.resource.data)
        && request.resource.data.get('userId', null) == resource.data.get('userId', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if isAdmin();
    }

    // Agenda por cancha y día: candado que evita reservas dobles (se escribe en transacciones).
    match /schedules/{id} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Clientes frecuentes para autocompletar el nombre.
    match /clients/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
    }
  }
}
